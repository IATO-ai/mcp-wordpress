# Files excluded from the WordPress.org distribution ZIP.
# Used by `wp dist-archive` and similar tools.
.git
.gitignore
.distignore
.DS_Store
.claude/
CLAUDE.md
docs/
*.docx
IATO-Phase2-WordPress.md

# WP.org asset overrides (served from SVN, not in plugin ZIP)
assets/icon-*.png
assets/screenshot-*.png
assets/banner-*.png

# Local WP.org SVN working copy (never include in plugin ZIP)
iato-mcp-svn/

# Plugin Check exported reports
iato-mcp-iato-mcp-php-*.md

# Dev tooling (not shipped)
tests/
composer.json
composer.lock
phpunit.xml.dist
.wp-env.json
.wp-env.override.json
vendor/
